{
  "name": "mhent-study",
  "version": "1.0.0",
  "description": "MHEnt Study — Music & Language Sanctuary Desktop & Mobile App (MHEnt Universe)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "build:web": "node build-web.js",
    "convert:icon": "node convert-icon.js",
    "pack": "npm run convert:icon && electron-builder --dir",
    "dist": "npm run convert:icon && electron-builder --publish never",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "node build-web.js && cap sync",
    "cap:copy": "node build-web.js && cap copy",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "keywords": [
    "mhent",
    "study",
    "lyrics",
    "language",
    "desktop",
    "mobile",
    "mhent-universe"
  ],
  "author": "Miyazaki Haruto Entertainment Co., Ltd.",
  "license": "UNLICENSED",
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0"
  },
  "build": {
    "appId": "com.mhentuniverse.study",
    "productName": "MHEnt. Study",
    "copyright": "© 2026 Miyazaki Haruto Entertainment Co., Ltd.",
    "buildVersion": "1.0.0",
    "directories": {
      "output": "dist",
      "buildResources": "installer"
    },
    "extraMetadata": {
      "description": "Không Gian Học Ngoại Ngữ Đa Vũ Trụ — Tiếng Hàn, Nhật, Trung, Anh"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!android/**",
      "!ios/**",
      "!www/**",
      "!.git/**",
      "!installer/**",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/study-logo.ico",
      "publisherName": "Miyazaki Haruto Entertainment Co., Ltd.",
      "legalTrademarks": "MHEnt. Study is a trademark of Miyazaki Haruto Entertainment Co., Ltd.",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "installer/installer.nsh",
      "artifactName": "MHEnt-Study-Setup-${version}.${ext}",
      "installerIcon": "assets/study-logo.ico",
      "uninstallerIcon": "assets/study-logo.ico",
      "installerHeaderIcon": "assets/study-logo.ico",
      "installerSidebar": "installer/sidebar-ins.bmp",
      "uninstallerSidebar": "installer/sidebar-ins.bmp",
      "license": "installer/license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MHEnt. Study",
      "menuCategory": "MHEnt Universe",
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false,
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ],
      "language": "1066",
      "displayLanguageSelector": false
    },
    "portable": {
      "artifactName": "MHEnt-Study-${version}-Portable.exe",
      "unicode": true
    }
  }
}
